<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>EV / 光圈 / 快門 / ISO 極簡計算器</title>
  <style>
    :root{
      color-scheme: light dark;
      --bg:#0b0b0c; --card:#151518; --text:#f2f2f2; --muted:#b6b6b6; --line:#2a2a2f;
      --accent:#5aa7ff;
    }
    body{
      margin:0; font-family: system-ui, -apple-system, "PingFang TC", "Noto Sans TC", Arial, sans-serif;
      background: var(--bg); color: var(--text);
      display:flex; align-items:center; justify-content:center; min-height:100vh; padding:16px;
    }
    .wrap{
      width:min(760px, 100%);
      background: var(--card);
      border:1px solid var(--line);
      border-radius:16px;
      padding:18px 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
    h1{ margin:0 0 8px 0; font-size:18px; font-weight:700; letter-spacing:.3px; }
    .hint{ margin:0 0 14px 0; color: var(--muted); font-size:13px; line-height:1.45; }
    .grid{ display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:12px; }
    .field{
      border:1px solid var(--line);
      border-radius:12px;
      padding:12px;
      background: rgba(255,255,255,.02);
    }
    .label{
      display:flex; justify-content:space-between; align-items:baseline;
      font-size:12px; color: var(--muted); margin-bottom:8px;
    }
    select{
      width:100%;
      padding:10px 12px;
      border-radius:10px;
      border:1px solid var(--line);
      background: rgba(0,0,0,.25);
      color: var(--text);
      font-size:16px;
      outline:none;
    }
    select:focus{ border-color: var(--accent); box-shadow: 0 0 0 3px rgba(90,167,255,.15); }
    .row{ margin-top:12px; display:flex; gap:10px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .status{ color: var(--muted); font-size:13px; }
    .status b{ color: var(--text); }
    button{
      padding:10px 12px; border-radius:10px; border:1px solid var(--line);
      background: rgba(255,255,255,.06); color: var(--text); cursor:pointer;
      font-size:14px;
    }
    button:hover{ background: rgba(255,255,255,.10); }
    .small{
      margin-top:10px; color: var(--muted); font-size:12px; line-height:1.5;
      border-top: 1px solid var(--line); padding-top:10px;
    }
    @media (max-width: 520px){ .grid{ grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>EV / 光圈 / 快門 / ISO 極簡計算器</h1>
    <p class="hint">四個下拉選單：只要選定其中 <b>三個</b>，系統會自動推算第 <b>四個</b>（並會選到最接近的檔位；下方會顯示精確值）。</p>

    <div class="grid">
      <div class="field">
        <div class="label"><span>EV</span><span id="evExact" aria-live="polite"></span></div>
        <select id="ev"></select>
      </div>

      <div class="field">
        <div class="label"><span>光圈（f/）</span><span id="apExact" aria-live="polite"></span></div>
        <select id="ap"></select>
      </div>

      <div class="field">
        <div class="label"><span>快門</span><span id="shExact" aria-live="polite"></span></div>
        <select id="sh"></select>
      </div>

      <div class="field">
        <div class="label"><span>ISO</span><span id="isoExact" aria-live="polite"></span></div>
        <select id="iso"></select>
      </div>
    </div>

    <div class="row">
      <div class="status" id="status">請先選三個數值。</div>
      <button id="reset" type="button">重置</button>
    </div>

    <div class="small">
      <div><b>計算公式</b></div>
      <div>EV = log₂(N² / t) − log₂(ISO / 100)</div>
      <div>N = f-number；t = 秒；ISO 以 100 為基準。</div>
    </div>
  </div>

<script>
(() => {
  const log2 = (x) => Math.log(x) / Math.log(2);
  const pow2 = (x) => Math.pow(2, x);

  function formatShutter(sec){
    if (sec >= 1) {
      const s = (sec >= 10) ? sec.toFixed(0) : (Math.abs(sec - Math.round(sec)) < 1e-6 ? sec.toFixed(0) : sec.toFixed(1));
      return `${s}s`;
    } else {
      const inv = 1 / sec;
      const denom = Math.round(inv);
      return `1/${denom}`;
    }
  }
  function formatAperture(n){
    return `f/${(Math.round(n*10)/10).toString().replace(/\.0$/,'')}`;
  }
  function formatEV(ev){
    const v = (Math.round(ev*10)/10).toString().replace(/\.0$/,'');
    return `EV ${v}`;
  }
  function nearestOption(value, options){
    let best = options[0];
    let bestD = Math.abs(options[0].value - value);
    for (const o of options){
      const d = Math.abs(o.value - value);
      if (d < bestD){ best = o; bestD = d; }
    }
    return best;
  }

  const evOptions = [];
  for (let v=-2; v<=20.0001; v+=0.5){
    evOptions.push({ value: Number(v.toFixed(1)), label: formatEV(v) });
  }

  const apValues = [1.0,1.1,1.2,1.4,1.6,1.8,2.0,2.2,2.5,2.8,3.2,3.5,4.0,4.5,5.0,5.6,6.3,7.1,8.0,9.0,10,11,13,14,16,18,20,22,25,29,32,36,40,45,51,57,64];
  const apOptions = apValues.map(v => ({ value: v, label: formatAperture(v) }));

  const shValues = [30,25,20,15,13,10,8,6,5,4,3.2,2.5,2,1.6,1.3,1,0.8,0.6,0.5,0.4,0.3,0.25,0.2,0.1666667,0.125,0.1,0.0833333,0.0666667,0.05,0.04,0.0333333,0.025,0.02,0.0166667,0.0125,0.01,0.008,0.00625,0.005,0.004,0.003125,0.0025,0.002,0.0015625,0.00125,0.001,0.0008,0.000625,0.0005];
  const shOptions = shValues.map(v => ({ value: v, label: formatShutter(v) }));

  const isoValues = [4,5,6,8,10,12,16,20,25,32,40,50,64,80,100,125,160,200,250,320,400,500,640,800,1000,1250,1600,2000,2500,3200,4000,5000,6400,8000,10000,12800];
  const isoOptions = isoValues.map(v => ({ value: v, label: String(v) }));

  const elEV  = document.getElementById('ev');
  const elAp  = document.getElementById('ap');
  const elSh  = document.getElementById('sh');
  const elISO = document.getElementById('iso');

  const evExact  = document.getElementById('evExact');
  const apExact  = document.getElementById('apExact');
  const shExact  = document.getElementById('shExact');
  const isoExact = document.getElementById('isoExact');
  const status = document.getElementById('status');

  function fillSelect(sel, options, placeholder){
    sel.innerHTML = '';
    const opt0 = document.createElement('option');
    opt0.value = '';
    opt0.textContent = placeholder;
    sel.appendChild(opt0);
    for (const o of options){
      const opt = document.createElement('option');
      opt.value = o.value;
      opt.textContent = o.label;
      sel.appendChild(opt);
    }
  }

  fillSelect(elEV,  evOptions,  '選 EV');
  fillSelect(elAp,  apOptions,  '選光圈');
  fillSelect(elSh,  shOptions,  '選快門');
  fillSelect(elISO, isoOptions, '選 ISO');

  // EV = log2(N^2/t) - log2(ISO/100)
  function calcEV(N, t, ISO){ return log2((N*N)/t) - log2(ISO/100); }
  function calcT(N, EV, ISO){ return (N*N) / pow2(EV + log2(ISO/100)); }
  function calcN(t, EV, ISO){ return Math.sqrt(t * pow2(EV + log2(ISO/100))); }
  function calcISO(N, t, EV){ return 100 * ((N*N)/t) / pow2(EV); }

  function clearExact(){ evExact.textContent=''; apExact.textContent=''; shExact.textContent=''; isoExact.textContent=''; }

  function update(){
    clearExact();
    const vEV  = elEV.value  === '' ? null : Number(elEV.value);
    const vAp  = elAp.value  === '' ? null : Number(elAp.value);
    const vSh  = elSh.value  === '' ? null : Number(elSh.value);
    const vISO = elISO.value === '' ? null : Number(elISO.value);

    const chosen = [vEV, vAp, vSh, vISO].filter(v => v !== null).length;
    if (chosen < 3){ status.innerHTML = '請先選 <b>三個</b> 數值。'; return; }
    if (chosen > 3){ status.innerHTML = '目前已選 <b>四個</b>，請清空其中一個，系統才會自動推算。'; return; }

    if (vEV === null){
      const ev = calcEV(vAp, vSh, vISO);
      const nearest = nearestOption(ev, evOptions);
      elEV.value = nearest.value;
      evExact.textContent = `精確：EV ${ev.toFixed(2)}`;
      status.innerHTML = `已推算 <b>EV</b>（最接近檔位：${nearest.label}）`;
    } else if (vAp === null){
      const n = calcN(vSh, vEV, vISO);
      const nearest = nearestOption(n, apOptions);
      elAp.value = nearest.value;
      apExact.textContent = `精確：${formatAperture(n)}`;
      status.innerHTML = `已推算 <b>光圈</b>（最接近檔位：${nearest.label}）`;
    } else if (vSh === null){
      const t = calcT(vAp, vEV, vISO);
      const nearest = nearestOption(t, shOptions);
      elSh.value = nearest.value;
      shExact.textContent = `精確：${formatShutter(t)}（${t.toFixed(4)}s）`;
      status.innerHTML = `已推算 <b>快門</b>（最接近檔位：${nearest.label}）`;
    } else if (vISO === null){
      const iso = calcISO(vAp, vSh, vEV);
      const nearest = nearestOption(iso, isoOptions);
      elISO.value = nearest.value;
      isoExact.textContent = `精確：ISO ${iso.toFixed(0)}`;
      status.innerHTML = `已推算 <b>ISO</b>（最接近檔位：ISO ${nearest.value}）`;
    }
  }

  [elEV, elAp, elSh, elISO].forEach(sel => sel.addEventListener('change', update));

  document.getElementById('reset').addEventListener('click', () => {
    elEV.value=''; elAp.value=''; elSh.value=''; elISO.value='';
    clearExact();
    status.innerHTML = '請先選三個數值。';
  });
})();
</script>
</body>
</html>